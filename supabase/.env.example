# ═══════════════════════════════════════════════════════════════
# Supabase Edge Functions - Environment Variables
# ═══════════════════════════════════════════════════════════════
#
# Copie este arquivo para .env e preencha com suas credenciais
# NUNCA commit o arquivo .env no Git
#
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# Supabase Configuration
# ─────────────────────────────────────────────────────────────

SUPABASE_URL=https://supa.rupies.com.br
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─────────────────────────────────────────────────────────────
# Asaas API Configuration
# ─────────────────────────────────────────────────────────────

# API Key do Asaas
# Obtenha em: https://www.asaas.com/config/api
# Sandbox: https://sandbox.asaas.com/config/api
ASAAS_API_KEY=your_asaas_api_key_here

# Environment: 'sandbox' ou 'production'
# Use 'sandbox' para testes
# Use 'production' para produção
ASAAS_ENVIRONMENT=sandbox

# ─────────────────────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────────────────────

# Nome da aplicação (para logs)
APP_NAME=Rupies Empresas

# Versão da API
API_VERSION=v1

# ─────────────────────────────────────────────────────────────
# Webhook Configuration
# ─────────────────────────────────────────────────────────────

# URL do webhook (será configurada no Asaas)
# Formato: https://supa.rupies.com.br/functions/v1/handle-asaas-webhook
WEBHOOK_URL=https://supa.rupies.com.br/functions/v1/handle-asaas-webhook

# ─────────────────────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────────────────────

# Habilitar logs detalhados
DEBUG_MODE=false

# Habilitar modo de teste (não cria cobranças reais)
TEST_MODE=false
